\NeedsTeXFormat{LaTeX2e}

\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{course-alchemist-review}
    {This template requires XeLaTeX or LuaLaTeX}
    {Use xelatex or lualatex with the selected font setup.}
\fi
\RequirePackage{fontspec}

